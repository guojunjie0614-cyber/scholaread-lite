{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["renderer/src/*"], "@shared/*": ["shared/*"] },
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "renderer/src/**/*.ts", "renderer/src/**/*.tsx"]
}
